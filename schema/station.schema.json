{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ooep/eki-play/schema/station.schema.json",
  "title": "駅周辺レコード（自動層）/ Station record (automated tier)",
  "description": "data/lines/<路線>.json の 车站[] の1要素。三語（ja/en/zh）で、各フィールドに出典情報を添える。",
  "type": "object",
  "required": [
    "车站ID",
    "名称",
    "所属线路",
    "位置",
    "分区",
    "統計",
    "データ品質"
  ],
  "additionalProperties": true,
  "properties": {
    "车站ID": {
      "type": "string",
      "description": "<路線日文>#<序号>"
    },
    "名称": {
      "type": "object",
      "required": [
        "日文"
      ],
      "properties": {
        "日文": {
          "type": [
            "string",
            "null"
          ],
          "description": "日本語版ウィキペディア見出し由来"
        },
        "日文原名": {
          "type": [
            "string",
            "null"
          ],
          "description": "eki-wiki の 名称.日文原名（県名付き例あり）"
        },
        "英文": {
          "type": [
            "string",
            "null"
          ],
          "description": "OSM name:en → Wikidata en ラベル。機械翻訳はしない"
        },
        "中文": {
          "type": [
            "string",
            "null"
          ],
          "description": "OSM name:zh → Wikidata zh ラベル → 中文ウィキ見出し"
        },
        "词条": {
          "type": [
            "string",
            "null"
          ]
        },
        "读音": {
          "type": [
            "string",
            "null"
          ]
        },
        "罗马字": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "所属线路": {
      "type": "object",
      "properties": {
        "日文": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "位置": {
      "type": "object",
      "required": [
        "坐标",
        "坐标可用"
      ],
      "properties": {
        "坐标": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "纬度",
                "经度"
              ],
              "properties": {
                "纬度": {
                  "type": "number"
                },
                "经度": {
                  "type": "number"
                },
                "出处": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "OpenStreetMap n/… ・ way/… ・ Wikidata (Q…) P625 ・日本語版ウィキペディア「…」座標"
                }
              }
            }
          ]
        },
        "坐标可用": {
          "type": "boolean"
        },
        "坐标来源": {
          "type": "object",
          "description": "表記差でOSM照合に失敗した後補座標の出典",
          "properties": {
            "来源": {
              "type": "string"
            },
            "出典": {
              "type": [
                "string",
                "null"
              ]
            },
            "記事": {
              "type": [
                "string",
                "null"
              ]
            },
            "理由": {
              "type": "string"
            },
            "取得日": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "坐标修正": {
          "type": "object",
          "description": "同名異県ノードの差替え／復元の履歴（旧値を必ず保持）",
          "properties": {
            "旧坐标": {
              "type": [
                "object",
                "null"
              ]
            },
            "偏差m": {
              "type": [
                "number",
                "null"
              ]
            },
            "旧偏差m": {
              "type": [
                "number",
                "null"
              ]
            },
            "結果": {
              "type": "string"
            },
            "判定": {
              "type": "object"
            },
            "根拠": {
              "type": "string"
            },
            "日付": {
              "type": "string",
              "format": "date"
            }
          }
        }
      }
    },
    "车站条目": {
      "type": "object",
      "properties": {
        "链接": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "首段": {
          "type": "object",
          "properties": {
            "日文": {
              "type": [
                "string",
                "null"
              ]
            },
            "英文": {
              "type": [
                "string",
                "null"
              ]
            },
            "中文": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "駅周辺原文": {
          "type": "object",
          "properties": {
            "日文": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "维基条目原文引用": {
          "type": "object",
          "description": "言語別の引用出典（wikipedia/ Wikidata）とライセンス",
          "additionalProperties": {
            "type": "object"
          }
        }
      }
    },
    "交通接続メモ": {
      "type": "object",
      "properties": {
        "バス路線原文": {
          "type": "object"
        }
      }
    },
    "公式リンク": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "分区": {
      "type": "object",
      "description": "6分類。各要素は周辺施設レコード",
      "properties": {
        "観光・名所案内": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/poi"
          }
        },
        "文化・公共施設": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/poi"
          }
        },
        "買い物・商店街": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/poi"
          }
        },
        "便民公共服务": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/poi"
          }
        },
        "交通接続": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/poi"
          }
        },
        "宿泊": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/poi"
          }
        }
      }
    },
    "統計": {
      "type": "object",
      "description": "分区ごとの件数",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "データ品質": {
      "type": "object",
      "properties": {
        "座標": {
          "type": "string",
          "description": "OSM / 未得 / 線外疑い / Wikipedia（線内照合で確定）…"
        },
        "座標注記": {
          "type": "object",
          "description": "線外疑い の理由・線内中心・許容半径・実測距離"
        },
        "未得理由": {
          "type": "string",
          "description": "座標が取れなかった駅の理由（廃止CS等）"
        },
        "OSM施設数": {
          "type": "integer"
        },
        "ウィキ_only数": {
          "type": "integer"
        },
        "駅周辺リンク数": {
          "type": "integer"
        }
      }
    }
  },
  "$defs": {
    "poi": {
      "description": "分区内の1件。三語名称＋距離＋官网＋出典",
      "type": "object",
      "required": [
        "名称",
        "类别",
        "距车站m",
        "来源"
      ],
      "properties": {
        "名称": {
          "type": "object",
          "properties": {
            "日文": {
              "type": [
                "string",
                "null"
              ]
            },
            "英文": {
              "type": [
                "string",
                "null"
              ]
            },
            "中文": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "类别": {
          "type": "object",
          "properties": {
            "日文": {
              "type": "string"
            },
            "英文": {
              "type": "string"
            },
            "中文": {
              "type": "string"
            }
          }
        },
        "细分": {
          "type": "object",
          "properties": {
            "日文": {
              "type": [
                "string",
                "null"
              ]
            },
            "英文": {
              "type": [
                "string",
                "null"
              ]
            },
            "中文": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "OSM类别": {
          "type": [
            "string",
            "null"
          ]
        },
        "距车站m": {
          "type": [
            "integer",
            "null"
          ],
          "description": "駅座標からの直線距離（歩行距離ではない）"
        },
        "坐标": {
          "type": [
            "object",
            "null"
          ]
        },
        "地址": {
          "type": [
            "string",
            "null"
          ]
        },
        "官网": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "官网検証": {
          "type": "object",
          "description": "HTTP code と確認日",
          "properties": {
            "HTTP": {
              "type": "integer"
            },
            "確認日": {
              "type": "string"
            }
          }
        },
        "官网_欠陥": {
          "type": "object",
          "description": "到達不可と判定して null にした記録"
        },
        "维基百科": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "Wikidata": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "电话": {
          "type": [
            "string",
            "null"
          ]
        },
        "开放时间": {
          "type": [
            "string",
            "null"
          ]
        },
        "简介": {
          "type": "object",
          "properties": {
            "日文": {
              "type": [
                "string",
                "null"
              ]
            },
            "英文": {
              "type": [
                "string",
                "null"
              ]
            },
            "中文": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "OSM编号": {
          "type": "string",
          "description": "node/… ・ way/…（面の重心は way）"
        },
        "来源": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "OpenStreetMap (ODbL) / 日本語版Wikipedia (CC BY-SA 4.0) / Wikidata (CC0)"
        }
      }
    }
  }
}